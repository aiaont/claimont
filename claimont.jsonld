      {
        "@language": "en",
        "@value": "Generic property that relates a claim or attestation to its predicate."
      },
      {
        "@language": "en",
        "@value": "Do not use this property directly - use its 'hasTextPredicate' or 'hasPropertyPredicate' subproperties instead."
      }
    ],
